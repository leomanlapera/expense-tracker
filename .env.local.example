# Copy to .env.local and fill in from Supabase project settings.
# Use the new publishable/secret keys (sb_publishable_… / sb_secret_…),
# NOT the deprecated anon/service_role keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. NEVER expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=sb_secret_...
